<source>
  @type tail
  path /var/log/ps-debug.json
  pos_file /var/log/ps-debug.json.pos
  tag cyphonic.ps.debug
  <parse>
    @type json
  </parse>
</source>

<source>
  @type tail
  path /var/log/ps-error.json
  pos_file /var/log/ps-error.json.pos
  tag cyphonic.ps.error
  <parse>
    @type json
  </parse>
</source>

<match cyphonic.**>
  @type elasticsearch
  host elasticsearch
  port 9200
  logstash_format true
</match>
